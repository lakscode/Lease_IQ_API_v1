{
  "_about": "What the lease Review checks after abstraction (Leases page → Review). Edit freely; the API loads it when it starts (restart the API, or redeploy the Edge Function, after a change). fields[].key must be an abstract field key from lib/abstract.ts (ABSTRACT_FIELDS). clauses[].match lists clause type names that count as this clause: names from CLAUSE_TYPES (Claude classifier) and from svm/lease_clauses.json (SVM / LangChain / Llama classifiers). required: a missing item is an issue; otherwise it is only noted. min_clause_confidence: predicted clauses below this score (0..1) are flagged for a closer look.",
  "min_clause_confidence": 0.5,
  "fields": [
    { "key": "landlord", "label": "Landlord", "required": true },
    { "key": "tenant", "label": "Tenant", "required": true },
    { "key": "guarantor", "label": "Guarantor", "required": false },
    { "key": "premises_address", "label": "Premises address", "required": true },
    { "key": "property_name", "label": "Property name", "required": false },
    { "key": "rentable_area", "label": "Rentable area (sq ft)", "required": true },
    { "key": "permitted_use", "label": "Permitted use", "required": true },
    { "key": "commencement_date", "label": "Commencement date", "required": true },
    { "key": "expiration_date", "label": "Expiration date", "required": true },
    { "key": "term_months", "label": "Term (months)", "required": true },
    { "key": "base_rent_monthly", "label": "Base rent (monthly)", "required": true },
    { "key": "base_rent_annual", "label": "Base rent (annual)", "required": false },
    { "key": "rent_escalations", "label": "Rent escalations", "required": false },
    { "key": "security_deposit", "label": "Security deposit", "required": false },
    { "key": "operating_expenses", "label": "Operating expenses / CAM", "required": false },
    { "key": "renewal_options", "label": "Renewal options", "required": false },
    { "key": "renewal_notice_months", "label": "Renewal notice (months before expiry)", "required": false },
    { "key": "termination_options", "label": "Termination options", "required": false }
  ],
  "clauses": [
    { "name": "Premises", "required": true, "match": ["Premises", "Leased Premises"] },
    { "name": "Term", "required": true, "match": ["Term", "Commencement", "Lease Term"] },
    { "name": "Permitted use", "required": true, "match": ["Use", "Permitted Uses", "Exclusive Use", "Prohibited Uses"] },
    { "name": "Base rent", "required": true, "match": ["Base Rent", "Rent Escalation", "CPI Adjustment"] },
    { "name": "Additional rent / operating expenses", "required": true, "match": ["Additional Rent", "Operating Expenses", "CAM", "Common Area Maintanence", "Gross-up"] },
    { "name": "Taxes", "required": true, "match": ["Real Estate Taxes", "Taxes"] },
    { "name": "Insurance", "required": true, "match": ["Insurance", "Waiver of Subrogation"] },
    { "name": "Security deposit", "required": false, "match": ["Security Deposit", "Letter of Credit"] },
    { "name": "Utilities", "required": false, "match": ["Utilities", "Services"] },
    { "name": "Repairs and maintenance", "required": true, "match": ["Repairs and Maintenance", "Repairs", "Landlord Obligations", "HVAC", "Roof"] },
    { "name": "Alterations", "required": false, "match": ["Alterations", "Tenant Improvements", "Improvement Allowance"] },
    { "name": "Assignment and subletting", "required": true, "match": ["Assignment and Subletting", "Change of Control", "Assignment and Subleasing", "Assignability and Exclusivity"] },
    { "name": "Renewal", "required": false, "match": ["Renewal Option", "Renewal"] },
    { "name": "Termination", "required": false, "match": ["Termination Option", "Early Termination", "Termination", "Kick Out"] },
    { "name": "Default and remedies", "required": true, "match": ["Default", "Remedies", "Landlord Default", "Events of Default"] },
    { "name": "Holdover", "required": false, "match": ["Holdover", "HoldOver"] },
    { "name": "Surrender", "required": false, "match": ["Surrender"] },
    { "name": "Casualty", "required": false, "match": ["Casualty", "Damage/Destruction"] },
    { "name": "Subordination", "required": false, "match": ["Subordination", "SNDA", "Mortgagee Protection"] },
    { "name": "Estoppel", "required": false, "match": ["Estoppel"] },
    { "name": "Guaranty", "required": false, "match": ["Guaranty"] },
    { "name": "Signage", "required": false, "match": ["Signage"] }
  ]
}
